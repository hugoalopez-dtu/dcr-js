<mxfile host="app.diagrams.net">
  <diagram id="approach-comparison" name="Approach Comparison">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="530" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══════════════════════════════════════════════════
             ROW 1 — Doumeni (NSGA-II) Approach
        ══════════════════════════════════════════════════ -->

        <mxCell id="title1" parent="1"
          style="text;html=1;align=center;verticalAlign=middle;
                 strokeColor=none;fillColor=none;
                 fontSize=14;fontStyle=1;fontColor=#1565C0;"
          value="Doumeni (NSGA-II) Approach"
          vertex="1">
          <mxGeometry x="175" y="28" width="460" height="30" as="geometry" />
        </mxCell>

        <!-- D1: Historical Event Logs (blue) -->
        <mxCell id="d1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;Historical Event Logs&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;(Real executions)&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="30" y="73" width="148" height="80" as="geometry" />
        </mxCell>

        <!-- D2: AgentSimulator (green) -->
        <mxCell id="d2" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;AgentSimulator&lt;br/&gt;(Process Model)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Learned behaviour and&lt;br/&gt;
                 transition probabilities from logs&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="223" y="73" width="168" height="80" as="geometry" />
        </mxCell>

        <!-- D3: NSGA-II (yellow) -->
        <mxCell id="d3" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;NSGA-II&lt;br/&gt;(Multi-objective GA)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Evolution of agent&lt;br/&gt;
                 assignment policies&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="438" y="73" width="168" height="80" as="geometry" />
        </mxCell>

        <!-- D4: Pareto Set of Policies (purple) -->
        <mxCell id="d4" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;Pareto Set of Policies&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Trade-off between&lt;br/&gt;
                 cost and wait time&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="653" y="73" width="168" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows row 1 -->
        <mxCell id="ad12" edge="1" source="d1" target="d2" parent="1"
          style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;
                 exitX=1;exitY=0.5;exitDX=0;exitDY=0;
                 entryX=0;entryY=0.5;entryDX=0;entryDY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ad23" edge="1" source="d2" target="d3" parent="1"
          style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;
                 exitX=1;exitY=0.5;exitDX=0;exitDY=0;
                 entryX=0;entryY=0.5;entryDX=0;entryDY=0;">
