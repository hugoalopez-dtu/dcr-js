          vertex="1">
          <mxGeometry x="175" y="225" width="460" height="30" as="geometry" />
        </mxCell>

        <!-- R1: DCR Model (blue) -->
        <mxCell id="r1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;DCR Model&lt;br/&gt;(Normative Specification)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Declarative process&lt;br/&gt;
                 constraints&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="30" y="270" width="148" height="80" as="geometry" />
        </mxCell>

        <!-- R2: Shielded Environment (green) -->
        <mxCell id="r2" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;Shielded Environment&lt;br/&gt;(DCR Semantics)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Actions filtered to enforce&lt;br/&gt;
                 DCR constraints&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="223" y="270" width="168" height="80" as="geometry" />
        </mxCell>

        <!-- R3: PPO (yellow) -->
        <mxCell id="r3" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
