        </mxCell>
        <mxCell id="ad34" edge="1" source="d3" target="d4" parent="1"
          style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;
                 exitX=1;exitY=0.5;exitDX=0;exitDY=0;
                 entryX=0;entryY=0.5;entryDX=0;entryDY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Compliance Banner Row 1 -->
        <mxCell id="cb1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;
                 dashed=1;dashPattern=8 4;strokeWidth=1.5;fontSize=11;"
          value="&lt;b&gt;Compliance: Statistical&lt;/b&gt;
                 (inherited from simulation fidelity and historical data)"
          vertex="1">
          <mxGeometry x="30" y="172" width="791" height="34" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════
             ROW 2 — This Work (DCR + RL)
        ══════════════════════════════════════════════════ -->

        <mxCell id="title2" parent="1"
          style="text;html=1;align=center;verticalAlign=middle;
