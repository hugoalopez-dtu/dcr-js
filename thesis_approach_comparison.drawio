                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;PPO&lt;br/&gt;(Reinforcement Learning)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Learns policies to optimise&lt;br/&gt;
                 cost–duration trade-off&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="438" y="270" width="168" height="80" as="geometry" />
        </mxCell>

        <!-- R4: Family of Policies (purple) -->
        <mxCell id="r4" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;
                 fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;
                 fontSize=11;verticalAlign=middle;spacingTop=4;"
          value="&lt;b&gt;Family of Policies&lt;br/&gt;(α, β Weights)&lt;/b&gt;&lt;br/&gt;
                 &lt;font style=&apos;font-size:10px;&apos;&gt;Weight-conditioned&lt;br/&gt;
                 policy solutions&lt;/font&gt;"
          vertex="1">
          <mxGeometry x="653" y="270" width="168" height="80" as="geometry" />
        </mxCell>

